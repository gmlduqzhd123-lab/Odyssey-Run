{
  "name": "odyssey-run",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-qa.ts",
    "test:mobile": "tsx scripts/mobile-qa.ts",
    "build": "npm run typecheck && vite build && tsx scripts/build-offline.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:release": "tsx scripts/release-qa.ts",
    "test:offline": "tsx scripts/offline-qa.ts",
    "test:update": "tsx scripts/update-qa.ts",
    "test:loading": "tsx scripts/loading-qa.ts",
    "test:structures": "tsx scripts/structures-qa.ts",
    "format": "prettier --write src tests scripts public/sw.js vite.config.ts",
    "format:check": "prettier --check src tests scripts public/sw.js vite.config.ts",
    "test:i18n": "tsx scripts/i18n-qa.ts",
    "test:classroom": "tsx scripts/classroom-qa.ts",
    "test:layout": "tsx scripts/layout-qa.ts",
    "test:access": "tsx scripts/access-qa.ts",
    "translations:export": "tsx scripts/translations.ts export",
    "translations:import": "tsx scripts/translations.ts import"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "phaser": "3.90.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "prettier": "3.9.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
